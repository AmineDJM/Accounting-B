# ---- Base ---------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=change-me
# Key used to encrypt exchange API keys at rest (openssl rand -base64 32)
APP_ENCRYPTION_KEY=change-me-too

# ---- Google sign-in -----------------------------------------------------
# Optional here: an administrator can paste the OAuth client into
# Administration > Installation instead, where it is stored encrypted and takes
# effect immediately. Set here, it wins over the console.
# Authorised redirect URI: <public URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Platform administrators ---------------------------------------------
# Two ways in for the very first administrator; the rest are created from the
# /admin console, because there is no self-service sign-up.
#
# 1. The start-up code: whoever holds it claims the platform on the login page,
#    and it stops working the moment an administrator exists. Twelve characters
#    minimum. The Render blueprint generates one automatically.
ADMIN_BOOTSTRAP_CODE=
# 2. Named addresses, created and promoted on first sign-in, always.
SUPER_ADMIN_EMAILS=

# ---- Database -----------------------------------------------------------
# Leave empty to use the embedded PGlite database in ./.data/pglite (dev only)
DATABASE_URL=
DB_AUTO_MIGRATE=true

# ---- Development helpers -------------------------------------------------
# Enables an email-only "demo login" on /login. NEVER enable in production.
AUTH_DEV_LOGIN=true

# ---- Optional -----------------------------------------------------------
# Override the Binance API base (e.g. https://api1.binance.com)
BINANCE_API_BASE=
# CoinGecko demo API key (fallback price source). The console takes it too.
COINGECKO_API_KEY=
# Public URL. Normally unnecessary: Auth.js derives it from the request.
AUTH_URL=
