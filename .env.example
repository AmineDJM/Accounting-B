# ---- Base ---------------------------------------------------------------
# Public URL of the app (Render: https://<service>.onrender.com)
AUTH_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=change-me
# Key used to encrypt exchange API keys at rest (openssl rand -base64 32)
APP_ENCRYPTION_KEY=change-me-too

# ---- Google sign-in (Google Cloud Console > APIs & Services > Credentials) --
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Platform administrators ---------------------------------------------
# Comma-separated addresses that are created and promoted to super-admin on
# first sign-in. Nobody else can sign up: every other account is created from
# the /admin console. Leave empty once the first administrator exists.
SUPER_ADMIN_EMAILS=

# ---- Database -----------------------------------------------------------
# Leave empty to use the embedded PGlite database in ./.data/pglite (dev only)
DATABASE_URL=
DB_AUTO_MIGRATE=true

# ---- Development helpers -------------------------------------------------
# Enables an email-only "demo login" on /login. NEVER enable in production.
AUTH_DEV_LOGIN=true

# ---- Optional -----------------------------------------------------------
# Override the Binance API base (e.g. https://api1.binance.com)
BINANCE_API_BASE=
# CoinGecko demo API key (fallback price source)
COINGECKO_API_KEY=
